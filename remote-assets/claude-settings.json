{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude SessionStart", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude UserPromptSubmit", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude Stop", "timeout": 10 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude StopFailure", "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude SubagentStop", "timeout": 10 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude PermissionRequest", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "__RUN__ claude AskUserQuestion", "timeout": 10 }] }],
    "Notification": [{ "matcher": "", "hooks": [{ "type": "command", "command": "__RUN__ claude Notification", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "__RUN__ claude SessionEnd", "timeout": 10 }] }]
  }
}
